{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "siphon-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": { "enabled": false },
  "vars": {
    "SIPHON_API_ENABLED": "false",
    "SIPHON_INSPECTION_WORKFLOW_ENABLED": "false",
  },
  "workflows": [
    {
      "name": "siphon-inspection",
      "binding": "SIPHON_INSPECTION",
      "class_name": "SiphonInspectionWorkflow",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "SIPHON_PRIVATE_KV",
      // Replace only after verifying the selected account is Workers Free.
      "id": "00000000000000000000000000000000",
    },
  ],
  "ratelimits": [
    {
      "name": "SIPHON_EDGE_LIMITER",
      // Deployment setup must reserve a unique namespace in the target account.
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
}
