{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "answer": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "questionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "selectedOptionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "customText": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "schemaVersion",
        "questionId",
        "selectedOptionId",
        "customText"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "unknown",
        "needs_reconciliation"
      ]
    },
    "facts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 100
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          },
          "provenance": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "code",
                  "config",
                  "user",
                  "inference",
                  "unknown"
                ]
              },
              "verification": {
                "type": "string",
                "enum": [
                  "unverified",
                  "confirmed",
                  "conflicting"
                ]
              },
              "references": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "artifactId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "sourceDigest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "line": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  },
                  "required": [
                    "artifactId",
                    "sourceDigest",
                    "line",
                    "description"
                  ],
                  "additionalProperties": false
                }
              },
              "explanation": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "required": [
              "kind",
              "verification",
              "references",
              "explanation"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "value",
          "unit",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    "explanation": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "schemaVersion",
    "answer",
    "state",
    "facts",
    "explanation"
  ],
  "additionalProperties": false
}
