{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "matched",
        "mismatched"
      ]
    },
    "comparedElements": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "observations": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "matched",
              "mismatched"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "missing_both",
                  "missing_original",
                  "missing_adapted",
                  "shape_mismatch",
                  "value_mismatch"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key",
          "status",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "comparedElements",
    "observations"
  ],
  "additionalProperties": false
}
