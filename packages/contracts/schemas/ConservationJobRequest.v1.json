{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "auditId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "revisionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "operationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "contextDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "validation": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "string",
              "const": "1.0"
            },
            "evaluationOperationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "sourceOperationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "inputDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "adapterDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "manifest": {
              "type": "object",
              "properties": {
                "schemaVersion": {
                  "type": "string",
                  "const": "1.0"
                },
                "operationId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "inputDigest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "adapterDigest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "executionProfile": {
                  "type": "string",
                  "const": "runpy_main_root_v1"
                },
                "observations": {
                  "minItems": 1,
                  "maxItems": 10,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "enum": [
                          "times",
                          "temperature",
                          "positions",
                          "velocities",
                          "masses",
                          "central_mu",
                          "gravity_constant",
                          "thermal_weights",
                          "source_power",
                          "outward_power"
                        ]
                      },
                      "filename": {
                        "type": "string",
                        "pattern": "^obs_[a-z][a-z0-9_]{0,63}\\.npy$"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "shape": {
                        "maxItems": 4,
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "dtype": {
                        "type": "string",
                        "const": "float64"
                      },
                      "declaredUnit": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      }
                    },
                    "required": [
                      "key",
                      "filename",
                      "sha256",
                      "bytes",
                      "shape",
                      "dtype",
                      "declaredUnit"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "schemaVersion",
                "operationId",
                "inputDigest",
                "adapterDigest",
                "executionProfile",
                "observations"
              ],
              "additionalProperties": false
            },
            "mappings": {
              "minItems": 1,
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "enum": [
                      "times",
                      "temperature",
                      "positions",
                      "velocities",
                      "masses",
                      "central_mu",
                      "gravity_constant",
                      "thermal_weights",
                      "source_power",
                      "outward_power"
                    ]
                  },
                  "root": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,99}$"
                  },
                  "steps": {
                    "maxItems": 8,
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "key"
                            },
                            "key": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            }
                          },
                          "required": [
                            "kind",
                            "key"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "index"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 1000000
                            }
                          },
                          "required": [
                            "kind",
                            "index"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "expectedShape": {
                    "maxItems": 4,
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 65536
                    }
                  },
                  "axisOrder": {
                    "maxItems": 4,
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3
                    }
                  },
                  "declaredUnit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "required": [
                  "key",
                  "root",
                  "steps",
                  "expectedShape",
                  "axisOrder",
                  "declaredUnit"
                ],
                "additionalProperties": false
              }
            },
            "maximumBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maximumElements": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "schemaVersion",
            "evaluationOperationId",
            "sourceOperationId",
            "inputDigest",
            "adapterDigest",
            "manifest",
            "mappings",
            "maximumBytes",
            "maximumElements"
          ],
          "additionalProperties": false
        },
        "profile": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "central_orbit_si"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "isolated_orbits_si"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "heat_energy_si"
                },
                "densityKgM3": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "heatCapacityJKgK": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "kind",
                "densityKgM3",
                "heatCapacityJKgK"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "heat_balance_si"
                },
                "densityKgM3": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "heatCapacityJKgK": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "kind",
                "densityKgM3",
                "heatCapacityJKgK"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "auditId",
        "revisionId",
        "operationId",
        "contextDigest",
        "validation",
        "profile"
      ],
      "additionalProperties": false
    },
    "eligibility": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "domain": {
          "type": "string",
          "enum": [
            "heat_diffusion",
            "orbital_dynamics"
          ]
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contextDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "adapterDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decisions": {
          "minItems": 5,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "checkId": {
                "type": "string",
                "enum": [
                  "H_ENERGY",
                  "H_BALANCE",
                  "H_TIME_REF",
                  "H_GRID_REF",
                  "H_REFERENCE",
                  "O_ENERGY",
                  "O_ANGULAR",
                  "O_MOMENTUM",
                  "O_REFINE",
                  "O_REFERENCE"
                ]
              },
              "registryVersion": {
                "type": "string",
                "const": "0.1.0"
              },
              "status": {
                "type": "string",
                "enum": [
                  "eligible",
                  "unresolved",
                  "ineligible"
                ]
              },
              "applicability": {
                "type": "string",
                "enum": [
                  "eligible",
                  "unresolved",
                  "ineligible"
                ]
              },
              "released": {
                "type": "boolean"
              },
              "reasons": {
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "requirement": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "supported_model",
                            "confirmed_units",
                            "verified_adapter",
                            "finite_observations",
                            "thermal_weights",
                            "closed_thermal_boundary",
                            "no_heat_sources",
                            "boundary_flux_observed",
                            "heat_sources_observed",
                            "time_quadrature_supported",
                            "internal_time_control",
                            "three_temporal_levels",
                            "same_physical_horizon",
                            "nested_grid_control",
                            "three_spatial_levels",
                            "common_coordinates",
                            "temporal_error_separated",
                            "matching_validated_reference",
                            "reference_accuracy_verified",
                            "reference_independent",
                            "inertial_frame",
                            "gravity_profile_confirmed",
                            "positions_velocities",
                            "masses_or_central_parameter",
                            "complete_gravity_model",
                            "isolated_mutual_gravity",
                            "compatible_angular_origin",
                            "bounded_trajectory_horizon",
                            "resource_budget_available"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "code": {
                      "type": "string",
                      "enum": [
                        "missing",
                        "unknown",
                        "conflicting",
                        "violated",
                        "check_not_released"
                      ]
                    }
                  },
                  "required": [
                    "requirement",
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "checkId",
              "registryVersion",
              "status",
              "applicability",
              "released",
              "reasons"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "domain",
        "inputDigest",
        "contextDigest",
        "adapterDigest",
        "decisions"
      ],
      "additionalProperties": false
    },
    "planDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidenceIds": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "H_ENERGY",
          "H_BALANCE",
          "H_TIME_REF",
          "H_GRID_REF",
          "H_REFERENCE",
          "O_ENERGY",
          "O_ANGULAR",
          "O_MOMENTUM",
          "O_REFINE",
          "O_REFERENCE"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "policies": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "H_ENERGY",
          "H_BALANCE",
          "H_TIME_REF",
          "H_GRID_REF",
          "H_REFERENCE",
          "O_ENERGY",
          "O_ANGULAR",
          "O_MOMENTUM",
          "O_REFINE",
          "O_REFERENCE"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "const": "reported_samples"
          },
          "target": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "justification": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "evidenceIds": {
                    "minItems": 1,
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  }
                },
                "required": [
                  "value",
                  "unit",
                  "justification",
                  "evidenceIds"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "scope",
          "target"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "diagnostic",
    "eligibility",
    "planDigest",
    "evidenceIds",
    "policies"
  ],
  "additionalProperties": false
}
