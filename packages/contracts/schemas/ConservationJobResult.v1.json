{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "auditId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "revisionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "operationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "validationOperationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "sourceOperationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contextDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "adapterDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profile": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "central_orbit_si"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "isolated_orbits_si"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "heat_energy_si"
                },
                "densityKgM3": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "heatCapacityJKgK": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "kind",
                "densityKgM3",
                "heatCapacityJKgK"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "heat_balance_si"
                },
                "densityKgM3": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "heatCapacityJKgK": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "kind",
                "densityKgM3",
                "heatCapacityJKgK"
              ],
              "additionalProperties": false
            }
          ]
        },
        "kind": {
          "type": "string",
          "const": "numeric_diagnostics"
        },
        "methodVersion": {
          "type": "string",
          "const": "0.1.0"
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "timeRangeSeconds": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "metrics": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "value": {
                "type": "number",
                "minimum": 0
              },
              "normalization": {
                "type": "string",
                "const": "absolute"
              },
              "status": {
                "type": "string",
                "const": "inconclusive"
              },
              "reason": {
                "type": "string",
                "const": "measurement_only"
              },
              "arithmetic": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "method": {
                        "type": "string",
                        "const": "decimal50_interval_v1"
                      },
                      "scope": {
                        "type": "string",
                        "const": "sampled_formula_roundoff"
                      },
                      "lower": {
                        "type": "number",
                        "minimum": 0
                      },
                      "upper": {
                        "type": "number",
                        "minimum": 0
                      },
                      "absoluteUncertaintyBound": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "method",
                      "scope",
                      "lower",
                      "upper",
                      "absoluteUncertaintyBound"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "name",
              "unit",
              "value",
              "normalization",
              "status",
              "reason",
              "arithmetic"
            ],
            "additionalProperties": false
          }
        },
        "limitations": {
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "required": [
        "schemaVersion",
        "auditId",
        "revisionId",
        "operationId",
        "validationOperationId",
        "sourceOperationId",
        "inputDigest",
        "contextDigest",
        "adapterDigest",
        "profile",
        "kind",
        "methodVersion",
        "sampleCount",
        "timeRangeSeconds",
        "metrics",
        "limitations"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "1.0"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "auditId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "revisionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "checkId": {
            "type": "string",
            "enum": [
              "H_ENERGY",
              "H_BALANCE",
              "H_TIME_REF",
              "H_GRID_REF",
              "H_REFERENCE",
              "O_ENERGY",
              "O_ANGULAR",
              "O_MOMENTUM",
              "O_REFINE",
              "O_REFERENCE"
            ]
          },
          "checkVersion": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "inputDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "contextDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "adapterDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "planDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "experimentIds": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "metric": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,99}$"
              },
              "value": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "normalization": {
                "type": "string",
                "const": "absolute"
              }
            },
            "required": [
              "name",
              "value",
              "unit",
              "normalization"
            ],
            "additionalProperties": false
          },
          "target": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "justification": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "evidenceIds": {
                    "minItems": 1,
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  }
                },
                "required": [
                  "value",
                  "unit",
                  "justification",
                  "evidenceIds"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "uncertainty": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "justification": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "evidenceIds": {
                    "minItems": 1,
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  }
                },
                "required": [
                  "value",
                  "unit",
                  "justification",
                  "evidenceIds"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "interval": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "lower": {
                    "type": "number",
                    "minimum": 0
                  },
                  "upper": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "lower",
                  "upper"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "passed_within_tolerance",
              "flagged",
              "inconclusive"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "whole_interval_within_target",
              "whole_interval_exceeds_target",
              "interval_overlaps_target",
              "missing_target",
              "missing_uncertainty_bound",
              "unrepresentable_interval"
            ]
          },
          "limitations": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        },
        "required": [
          "schemaVersion",
          "id",
          "auditId",
          "revisionId",
          "checkId",
          "checkVersion",
          "inputDigest",
          "contextDigest",
          "adapterDigest",
          "planDigest",
          "experimentIds",
          "metric",
          "target",
          "uncertainty",
          "interval",
          "status",
          "reason",
          "limitations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "diagnostics",
    "evidence"
  ],
  "additionalProperties": false
}
