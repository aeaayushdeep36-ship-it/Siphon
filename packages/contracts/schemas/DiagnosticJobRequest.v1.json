{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "auditId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "revisionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "operationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "contextDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "validation": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "evaluationOperationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "sourceOperationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "adapterDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifest": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "string",
              "const": "1.0"
            },
            "operationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "inputDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "adapterDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "executionProfile": {
              "type": "string",
              "const": "runpy_main_root_v1"
            },
            "observations": {
              "minItems": 1,
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "enum": [
                      "times",
                      "temperature",
                      "positions",
                      "velocities",
                      "masses",
                      "central_mu",
                      "gravity_constant",
                      "thermal_weights",
                      "source_power",
                      "outward_power"
                    ]
                  },
                  "filename": {
                    "type": "string",
                    "pattern": "^obs_[a-z][a-z0-9_]{0,63}\\.npy$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "shape": {
                    "maxItems": 4,
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "dtype": {
                    "type": "string",
                    "const": "float64"
                  },
                  "declaredUnit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "required": [
                  "key",
                  "filename",
                  "sha256",
                  "bytes",
                  "shape",
                  "dtype",
                  "declaredUnit"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "schemaVersion",
            "operationId",
            "inputDigest",
            "adapterDigest",
            "executionProfile",
            "observations"
          ],
          "additionalProperties": false
        },
        "mappings": {
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "enum": [
                  "times",
                  "temperature",
                  "positions",
                  "velocities",
                  "masses",
                  "central_mu",
                  "gravity_constant",
                  "thermal_weights",
                  "source_power",
                  "outward_power"
                ]
              },
              "root": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,99}$"
              },
              "steps": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "key"
                        },
                        "key": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        }
                      },
                      "required": [
                        "kind",
                        "key"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "index"
                        },
                        "index": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000
                        }
                      },
                      "required": [
                        "kind",
                        "index"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "expectedShape": {
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 65536
                }
              },
              "axisOrder": {
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                }
              },
              "declaredUnit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "key",
              "root",
              "steps",
              "expectedShape",
              "axisOrder",
              "declaredUnit"
            ],
            "additionalProperties": false
          }
        },
        "maximumBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maximumElements": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schemaVersion",
        "evaluationOperationId",
        "sourceOperationId",
        "inputDigest",
        "adapterDigest",
        "manifest",
        "mappings",
        "maximumBytes",
        "maximumElements"
      ],
      "additionalProperties": false
    },
    "profile": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "central_orbit_si"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "isolated_orbits_si"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "heat_energy_si"
            },
            "densityKgM3": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "heatCapacityJKgK": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "densityKgM3",
            "heatCapacityJKgK"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "heat_balance_si"
            },
            "densityKgM3": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "heatCapacityJKgK": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "densityKgM3",
            "heatCapacityJKgK"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "auditId",
    "revisionId",
    "operationId",
    "contextDigest",
    "validation",
    "profile"
  ],
  "additionalProperties": false
}
