{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "domain": {
      "type": "string",
      "enum": [
        "heat_diffusion",
        "orbital_dynamics"
      ]
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contextDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "adapterDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decisions": {
      "minItems": 5,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "checkId": {
            "type": "string",
            "enum": [
              "H_ENERGY",
              "H_BALANCE",
              "H_TIME_REF",
              "H_GRID_REF",
              "H_REFERENCE",
              "O_ENERGY",
              "O_ANGULAR",
              "O_MOMENTUM",
              "O_REFINE",
              "O_REFERENCE"
            ]
          },
          "registryVersion": {
            "type": "string",
            "const": "0.1.0"
          },
          "status": {
            "type": "string",
            "enum": [
              "eligible",
              "unresolved",
              "ineligible"
            ]
          },
          "applicability": {
            "type": "string",
            "enum": [
              "eligible",
              "unresolved",
              "ineligible"
            ]
          },
          "released": {
            "type": "boolean"
          },
          "reasons": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "requirement": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "supported_model",
                        "confirmed_units",
                        "verified_adapter",
                        "finite_observations",
                        "thermal_weights",
                        "closed_thermal_boundary",
                        "no_heat_sources",
                        "boundary_flux_observed",
                        "heat_sources_observed",
                        "time_quadrature_supported",
                        "internal_time_control",
                        "three_temporal_levels",
                        "same_physical_horizon",
                        "nested_grid_control",
                        "three_spatial_levels",
                        "common_coordinates",
                        "temporal_error_separated",
                        "matching_validated_reference",
                        "reference_accuracy_verified",
                        "reference_independent",
                        "inertial_frame",
                        "gravity_profile_confirmed",
                        "positions_velocities",
                        "masses_or_central_parameter",
                        "complete_gravity_model",
                        "isolated_mutual_gravity",
                        "compatible_angular_origin",
                        "bounded_trajectory_horizon",
                        "resource_budget_available"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "code": {
                  "type": "string",
                  "enum": [
                    "missing",
                    "unknown",
                    "conflicting",
                    "violated",
                    "check_not_released"
                  ]
                }
              },
              "required": [
                "requirement",
                "code"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "checkId",
          "registryVersion",
          "status",
          "applicability",
          "released",
          "reasons"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "domain",
    "inputDigest",
    "contextDigest",
    "adapterDigest",
    "decisions"
  ],
  "additionalProperties": false
}
