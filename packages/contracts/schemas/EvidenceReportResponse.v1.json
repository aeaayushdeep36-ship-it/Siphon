            "evidenceIds": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "comparedElements": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "explanation",
            "evidenceIds",
            "comparedElements"
          ],
          "additionalProperties": false
        },
        "checks": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "checkId": {
                "type": "string",
                "enum": [
                  "H_ENERGY",
                  "H_BALANCE",
                  "H_TIME_REF",
                  "H_GRID_REF",
                  "H_REFERENCE",
                  "O_ENERGY",
                  "O_ANGULAR",
                  "O_MOMENTUM",
                  "O_REFINE",
                  "O_REFERENCE"
                ]
              },
              "checkVersion": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              "selection": {
                "type": "string",
                "enum": [
                  "selected",
                  "excluded",
                  "unresolved"
                ]
              },
              "reasons": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "procedure": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "requiredObservations": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "accuracyPolicy": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "referenceIds": {
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                }
              },
              "experimentIds": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              },
              "metricEvidenceIds": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              }
            },
            "required": [
              "checkId",
              "checkVersion",
              "selection",
              "reasons",
              "procedure",
              "requiredObservations",
              "accuracyPolicy",
              "referenceIds",
              "experimentIds",
              "metricEvidenceIds"
            ],
            "additionalProperties": false
          }
        },
        "experiments": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "status": {
                "type": "string",
                "enum": [
                  "completed",
                  "failed",
                  "not_run",
                  "cancelled"
                ]
              },
              "controls": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "value": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "unit": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "value",
                    "unit"
                  ],
                  "additionalProperties": false
                }
              },
              "sourceOperationId": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "resultDigest": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "description",
              "status",
              "controls",
              "sourceOperationId",
              "resultDigest"
            ],
            "additionalProperties": false
          }
        },
        "metrics": {
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "string",
                "const": "1.0"
              },
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "auditId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "revisionId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "checkId": {
                "type": "string",
                "enum": [
                  "H_ENERGY",
                  "H_BALANCE",
                  "H_TIME_REF",
                  "H_GRID_REF",
                  "H_REFERENCE",
                  "O_ENERGY",
                  "O_ANGULAR",
                  "O_MOMENTUM",
                  "O_REFINE",
                  "O_REFERENCE"
                ]
              },
              "checkVersion": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              "inputDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "contextDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "adapterDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "planDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "experimentIds": {
                "minItems": 1,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              },
              "metric": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,99}$"
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "normalization": {
                    "type": "string",
                    "const": "absolute"
                  }
                },
                "required": [
                  "name",
                  "value",
                  "unit",
                  "normalization"
                ],
                "additionalProperties": false
              },
              "target": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "number",
                        "minimum": 0
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "justification": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "evidenceIds": {
                        "minItems": 1,
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        }
                      }
                    },
                    "required": [
                      "value",
                      "unit",
                      "justification",
                      "evidenceIds"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "uncertainty": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "number",
                        "minimum": 0
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "justification": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "evidenceIds": {
                        "minItems": 1,
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        }
                      }
                    },
                    "required": [
                      "value",
                      "unit",
                      "justification",
                      "evidenceIds"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "interval": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "lower": {
                        "type": "number",
                        "minimum": 0
                      },
                      "upper": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "lower",
                      "upper"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed_within_tolerance",
                  "flagged",
                  "inconclusive"
                ]
              },
              "reason": {
                "type": "string",
                "enum": [
                  "whole_interval_within_target",
                  "whole_interval_exceeds_target",
