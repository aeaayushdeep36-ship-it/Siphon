            "explanation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "evidenceIds": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            }
          },
          "required": [
            "status",
            "explanation",
            "evidenceIds"
          ],
          "additionalProperties": false
