            "required": [
              "schemaVersion",
              "id",
              "auditId",
              "revisionId",
              "checkId",
              "checkVersion",
              "inputDigest",
              "contextDigest",
              "adapterDigest",
              "planDigest",
              "experimentIds",
              "metric",
              "target",
              "uncertainty",
              "interval",
              "status",
              "reason",
              "limitations"
            ],
            "additionalProperties": false
          }
        },
