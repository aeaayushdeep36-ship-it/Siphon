{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "enum": [
        "times",
        "temperature",
        "positions",
        "velocities",
        "masses",
        "central_mu",
        "gravity_constant",
        "thermal_weights",
        "source_power",
        "outward_power"
      ]
    },
    "root": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,99}$"
    },
    "steps": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "key"
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "kind",
              "key"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "index"
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              }
            },
            "required": [
              "kind",
              "index"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "expectedShape": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 65536
      }
    },
    "axisOrder": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 3
      }
    },
    "declaredUnit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  },
  "required": [
    "key",
    "root",
    "steps",
    "expectedShape",
    "axisOrder",
    "declaredUnit"
  ],
  "additionalProperties": false
}
