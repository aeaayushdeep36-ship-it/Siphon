{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "evaluationOperationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "sourceOperationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "adapterDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "validation": {
      "type": "string",
      "const": "validated_numeric_structure"
    },
    "totalBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "totalElements": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "observations": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "times",
              "temperature",
              "positions",
              "velocities",
              "masses",
              "central_mu",
              "gravity_constant",
              "thermal_weights",
              "source_power",
              "outward_power"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "shape": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 65536
            }
          },
          "dtype": {
            "type": "string",
            "const": "float64"
          },
          "originalDtype": {
            "type": "string",
            "pattern": "^[<>=]f8$"
          },
          "conversion": {
            "type": "string",
            "enum": [
              "none",
              "exact_to_float64"
            ]
          },
          "declaredUnit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "elements": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "key",
          "sha256",
          "bytes",
          "shape",
          "dtype",
          "originalDtype",
          "conversion",
          "declaredUnit",
          "elements"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "evaluationOperationId",
    "sourceOperationId",
    "inputDigest",
    "adapterDigest",
    "validation",
    "totalBytes",
    "totalElements",
    "observations"
  ],
  "additionalProperties": false
}
