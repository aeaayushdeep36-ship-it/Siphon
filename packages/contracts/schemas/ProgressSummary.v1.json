{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "auditId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "revisionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "draft",
        "inspecting",
        "clarifying",
        "adapting",
        "planning",
        "executing",
        "evaluating",
        "investigating",
        "reporting",
        "finished"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "idle",
        "queued",
        "running",
        "waiting_for_input",
        "completed",
        "partial",
        "failed",
        "cancelled",
        "unsupported"
      ]
    },
    "activity": {
      "type": "string",
      "enum": [
        "queued",
        "inspecting_upload",
        "reading_context",
        "awaiting_answers",
        "verifying_adapter",
        "planning_checks",
        "running_experiment",
        "evaluating_evidence",
        "investigating_findings",
        "rendering_report",
        "finished",
        "cancel_requested"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "experiments": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "completed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "planned": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "completed",
            "planned"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "eventCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timelineCapped": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "auditId",
    "revisionId",
    "stage",
    "status",
    "activity",
    "message",
    "updatedAt",
    "experiments",
    "eventCount",
    "timelineCapped"
  ],
  "additionalProperties": false
}
