{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_.]{0,99}$"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "options": {
      "minItems": 2,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "unknown": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "unknown"
        ],
        "additionalProperties": false
      }
    },
    "customTextAllowed": {
      "type": "boolean",
      "const": true
    },
    "requiredFacts": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "affectedChecks": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "H_ENERGY",
          "H_BALANCE",
          "H_TIME_REF",
          "H_GRID_REF",
          "H_REFERENCE",
          "O_ENERGY",
          "O_ANGULAR",
          "O_MOMENTUM",
          "O_REFINE",
          "O_REFERENCE"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "key",
    "prompt",
    "reason",
    "options",
    "customTextAllowed",
    "requiredFacts",
    "affectedChecks"
  ],
  "additionalProperties": false
}
