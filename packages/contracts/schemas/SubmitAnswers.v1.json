{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "expectedGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expectedInputDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "questionSetDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "answers": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "1.0"
          },
          "questionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "selectedOptionId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "customText": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": [
          "schemaVersion",
          "questionId",
          "selectedOptionId",
          "customText"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "expectedGeneration",
    "expectedInputDigest",
    "questionSetDigest",
    "answers"
  ],
  "additionalProperties": false
}
